# Environment Configuration for AVNIVO

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AVNIVO"
NEXT_PUBLIC_APP_TAGLINE="Discover. Compare. Shop."

# Database (Default: SQLite for friction-free local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://avnivo_user:secure_password@localhost:5432/avnivo_db?schema=public"

# Authentication Secrets
JWT_SECRET="avnivo-super-secret-jwt-key-change-in-production-2025"
ADMIN_REGISTRATION_TOKEN="avnivo-admin-key-secure"

# Affiliate Tracking Settings
DEFAULT_AFFILIATE_UTM_SOURCE="avnivo"
DEFAULT_AFFILIATE_UTM_MEDIUM="affiliate_discovery"

# Feature Flags (Future modules kept extensible)
NEXT_PUBLIC_FEATURE_DIRECT_CHECKOUT="false"
NEXT_PUBLIC_FEATURE_MULTI_VENDOR="false"
