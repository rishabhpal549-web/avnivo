{
  "expo": {
    "name": "AVNIVO",
    "slug": "avnivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101B35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avnivo.shopping"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101B35"
      },
      "package": "com.avnivo.shopping"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://avnivo.vercel.app/api"
    }
  }
}
